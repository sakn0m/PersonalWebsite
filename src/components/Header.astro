---
const navLinks = [
  { label: 'About', href: '/#about' },
  { label: 'Projects', href: '/#projects' },
  { label: 'Writing', href: '/#writing' },
  { label: 'Connect', href: '/#connect' },
  { label: 'CV', href: '/Giorgio-Vanini-CV.pdf', external: true },
];
---

<div class="masthead" data-nosnippet>
  <nav class="breadcrumbs" aria-label="breadcrumbs">
    <ol>
      <li class="breadcrumb-current"><a href="/" aria-current="page">Giorgio Vanini</a></li>
    </ol>
  </nav>

  <nav class="masthead-nav" aria-label="main">
    <ul>
      {navLinks.map(link => (
        <li>
          <a
            href={link.href}
            target={link.external ? '_blank' : undefined}
            rel={link.external ? 'noopener noreferrer' : undefined}
          >{link.label}</a>
        </li>
      ))}
    </ul>
  </nav>
</div>

<style>
  .masthead {
    align-items: baseline;
  }

  .breadcrumb-current a {
    font-size: 1rem;
  }

  .masthead-nav {
    margin-left: auto;
  }

  .masthead-nav ul {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .masthead-nav a {
    font-size: 0.875rem;
    text-decoration: none;
    text-transform: lowercase;
    padding: 0.25rem 0.25rem;
  }

  @media (max-width: 767px) {
    .masthead-nav {
      display: none;
    }
  }
</style>
