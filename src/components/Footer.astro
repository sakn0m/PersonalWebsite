---
const year = new Date().getFullYear();
---

<footer>
  <p class="authorship"><small><strong>Rome, Italy.</strong> &copy; {year} Giorgio Vanini. Built with Astro.</small></p>
</footer>

<style>
  footer {
    margin-top: 4rem;
    border-top: 1px solid var(--rule);
    padding-top: 1rem;
  }

  .authorship,
  .authorship small {
    font-size: 0.75rem;
    max-width: 34em;
    line-height: 1.25;
  }

  .authorship strong {
    font-weight: 400;
  }

  @media (min-width: 768px) {
    footer {
      margin-top: 8rem;
    }
  }
</style>
