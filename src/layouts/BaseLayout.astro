---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = 'BSc AI & Management student at LUISS Guido Carli. Writing about AI, data, and digital sovereignty.',
  ogImage = '/og-image.png',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" href="/icon.png" type="image/png" />
  <link rel="canonical" href={canonicalURL} />

  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="keywords" content="Giorgio Vanini, AI, Data Analysis, Machine Learning, Management, LUISS" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL(ogImage, Astro.site)} />
  <meta property="og:site_name" content="Giorgio Vanini" />
  <meta property="og:locale" content="en_US" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />

  <!-- JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Giorgio Vanini",
    "url": "https://giorgiovanini.eu",
    "jobTitle": "AI & Management Student",
    "affiliation": {
      "@type": "Organization",
      "name": "LUISS Guido Carli"
    },
    "sameAs": [
      "https://www.linkedin.com/in/giorgio-vanini-8627123a4/",
      "https://github.com/sakn0m",
      "https://jojo.news"
    ],
    "knowsAbout": [
      "Artificial Intelligence",
      "Data Analysis",
      "Machine Learning",
      "Digital Sovereignty"
    ]
  })} />
</head>
<body>
  <a class="skip-link" href="#main">Skip to main content</a>
  <Header />
  <main id="main">
    <slot />
  </main>
  <Footer />
</body>
</html>
