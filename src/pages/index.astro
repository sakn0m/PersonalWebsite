---
import BaseLayout from '../layouts/BaseLayout.astro';
import { articles } from '../data/articles';

const recentArticles = articles.slice(0, 3);

const projects = [
  {
    name: 'Expert AI Project',
    description: 'NLP project for expert.ai built during the LUISS Grand Challenge course.',
    tech: 'jupyter',
    href: 'https://github.com/sakn0m/expert_ai_project_LUISS',
  },
  {
    name: 'Bankruptcy Screener',
    description: 'Bankruptcy risk screening dashboard developed as part of the Expert AI project.',
    tech: 'next.js / react / tailwind / recharts',
    href: 'https://github.com/sakn0m/bankruptcy-screener',
  },
  {
    name: 'SNA Project',
    description: 'Social network analysis research and visualisation.',
    tech: 'jupyter',
    href: 'https://github.com/sakn0m/SNA_Project',
  },
  {
    name: 'S&P 500 Predictor',
    description: 'ML model predicting S&P 500 movements and top-performing stocks in the short term.',
    tech: 'python / ml',
    href: 'https://github.com/sakn0m/S-P500-Predictor',
  },
  {
    name: 'Audience Decode',
    description: 'Unsupervised audience segmentation on 100M streaming interactions — dual clustering of users and movies to reveal preference patterns.',
    tech: 'jupyter / ml',
    href: 'https://github.com/ariannacambi/AudienceDecode-317971',
  },
  {
    name: 'Personal Website',
    description: 'This very site — built with Astro.',
    tech: 'astro / css',
    href: 'https://github.com/sakn0m/PersonalWebsite',
  },
];
---

<BaseLayout title="Giorgio Vanini: AI & Management Student">
  <!-- ═══ HEADER ═══ -->
  <header class="home-header">
    <h1>
      <span class="sr-only">Giorgio Vanini is a </span>BSc student in AI &amp; management, data
      analyst, and writer <span class="clause">working with machine learning, agentic
      development tools, and questions of digital sovereignty in Europe.</span>
    </h1>
  </header>

  <!-- ═══ ABOUT ═══ -->
  <section class="section" id="about">
    <header>
      <h2>About</h2>
    </header>
    <section class="subsection">
      <header>
        <h3>Background</h3>
      </header>
      <div class="section-contents">
        <p>Second-year student at LUISS Guido Carli, pursuing a BSc in AI &amp; Management.
          My academic focus lies in data analysis, machine learning applications, and digital
          transformation in management.</p>
      </div>
    </section>
    <section class="subsection">
      <header>
        <h3>Practice</h3>
      </header>
      <div class="section-contents">
        <p>In my own development practice, I work with AI agents to build and maintain software,
          continuously exploring how agentic tools can improve the way we write, refactor, and
          understand code.</p>
      </div>
    </section>
    <section class="subsection">
      <header>
        <h3>Beyond studies</h3>
      </header>
      <div class="section-contents">
        <p>European politics and geopolitics, digital privacy, encryption, and secure digital
          communications. I frequently write about the intersection of technology and
          sovereignty at <a href="https://jojo.news" target="_blank" rel="noopener noreferrer">jojo.news</a>.
          I believe in open-source software and the democratic governance of AI.</p>
      </div>
    </section>
    <section class="subsection">
      <header>
        <h3>Education</h3>
      </header>
      <div class="section-contents">
        <p>BSc, Artificial Intelligence &amp; Management — LUISS Guido Carli (in progress).</p>
      </div>
    </section>
    <section class="subsection">
      <header>
        <h3>Details</h3>
      </header>
      <div class="section-contents">
        <p>Rome, Italy. Italian, English, French.</p>
      </div>
    </section>
  </section>

  <!-- ═══ PROJECTS ═══ -->
  <section class="section" id="projects">
    <header>
      <h2>Projects</h2>
    </header>
    {projects.map(project => (
      <section class="subsection">
        <header>
          <h3>
            <a href={project.href} target="_blank" rel="noopener noreferrer">{project.name}</a><span class="fw3" aria-hidden="true"> →</span>
          </h3>
        </header>
        <div class="section-contents">
          <p>{project.description}</p>
          <p class="muted tech">{project.tech}</p>
        </div>
      </section>
    ))}
    <section class="subsection">
      <header>
        <h3><a href="https://github.com/sakn0m" target="_blank" rel="noopener noreferrer">All projects</a><span class="fw3" aria-hidden="true"> →</span></h3>
      </header>
      <div class="section-contents">
        <p>The rest of my work lives on GitHub.</p>
      </div>
    </section>
  </section>

  <!-- ═══ WRITING ═══ -->
  <section class="section" id="writing">
    <header>
      <h2>Writing</h2>
    </header>
    {recentArticles.map(article => (
      <section class="subsection">
        <header>
          <h3>
            <a href={article.href} target="_blank" rel="noopener noreferrer">{article.title}</a><span class="fw3" aria-hidden="true"> →</span>
          </h3>
        </header>
        <div class="section-contents">
          <p class="muted">{article.tag} · {article.date}</p>
        </div>
      </section>
    ))}
    <section class="subsection">
      <header>
        <h3><a href="/blog">More articles</a><span class="fw3" aria-hidden="true"> →</span></h3>
      </header>
      <div class="section-contents">
        <p>Everything else lives on the blog.</p>
      </div>
    </section>
  </section>

  <!-- ═══ CONNECT ═══ -->
  <section class="section" id="connect">
    <header>
      <h2>Connect</h2>
    </header>
    <section class="subsection">
      <header>
        <h3>Elsewhere</h3>
      </header>
      <div class="section-contents">
        <p>
          <a href="https://github.com/sakn0m" target="_blank" rel="noopener noreferrer">GitHub</a>,
          <a href="https://www.linkedin.com/in/giorgio-vanini-8627123a4/" target="_blank" rel="noopener noreferrer">LinkedIn</a>,
          and <a href="https://jojo.news" target="_blank" rel="noopener noreferrer">jojo.news</a>.
        </p>
      </div>
    </section>
    <section class="subsection">
      <header>
        <h3>Resume</h3>
      </header>
      <div class="section-contents">
        <p><a href="/Giorgio-Vanini-CV.pdf" target="_blank" rel="noopener noreferrer">Download my CV</a> (PDF).</p>
      </div>
    </section>
    <section class="subsection">
      <header>
        <h3>Contact</h3>
      </header>
      <div class="section-contents">
        <p><a href="mailto:giorgio@giorgiovanini.eu">Send a message</a> about projects, writing, or collaborations.</p>
      </div>
    </section>
  </section>
</BaseLayout>

<style>
  .home-header {
    margin-top: 8rem;
  }

  .home-header h1 {
    font-size: 1.5rem;
    font-weight: 400;
    line-height: 1.25;
    max-width: 48rem;
    margin-bottom: 2rem;
    text-wrap: balance;
  }

  .home-header .clause {
    font-weight: 300;
  }

  .subsection h3 a {
    font-weight: 500;
  }

  .tech {
    font-size: 0.875rem;
    margin-top: 0.5rem;
  }

  @media (min-width: 768px) {
    .home-header {
      margin-top: 16rem;
    }

    .home-header h1 {
      font-size: 2.25rem;
      line-height: 1;
    }
  }
</style>
