---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { articles } from '../../data/articles';
---

<BaseLayout title="Writing — Giorgio Vanini" description="Articles on AI, European politics, and geopolitics.">
  <header class="writing-header">
    <h1>Writing</h1>
  </header>

  <section class="writing-list">
    {articles.map(article => (
      <article class="writing-item">
        <h2>
          <a
            href={article.href}
            target={article.external ? '_blank' : undefined}
            rel={article.external ? 'noopener noreferrer' : undefined}
          >{article.title}</a><span class="fw3" aria-hidden="true"> →</span>
        </h2>
        <dl>
          <div>
            <dt>Published in</dt>
            <dd>{article.tag}</dd>
          </div>
          <div>
            <dt>Date</dt>
            <dd>{article.date}</dd>
          </div>
          {article.subtitle && (
            <div>
              <dt>Note</dt>
              <dd>{article.subtitle}</dd>
            </div>
          )}
        </dl>
      </article>
    ))}
  </section>
</BaseLayout>

<style>
  .writing-header {
    margin-top: 8rem;
    margin-bottom: 4rem;
  }

  .writing-header h1 {
    font-size: 3rem;
    font-weight: 400;
    line-height: 0.92;
    text-transform: lowercase;
  }

  .writing-item {
    padding-top: 2rem;
    margin-top: 2rem;
  }

  .writing-item + .writing-item {
    border-top: 1px solid var(--rule);
  }

  .writing-item h2 {
    font-size: 1.25rem;
    font-weight: 500;
    line-height: 1.35;
    max-width: none;
  }

  .writing-item h2 a {
    text-decoration: none;
  }

  .writing-item dl {
    display: flex;
    flex-wrap: wrap;
    gap: 0 2rem;
    margin-top: 1rem;
  }

  .writing-item dl div {
    display: flex;
    gap: 0.5ch;
    align-items: baseline;
    margin: 0;
  }

  .writing-item dt {
    font-size: 0.875rem;
    text-transform: lowercase;
    color: var(--muted);
  }

  .writing-item dd {
    font-size: 0.875rem;
    margin: 0;
  }

  @media (min-width: 768px) {
    .writing-header {
      margin-top: 16rem;
      margin-bottom: 8rem;
    }

    .writing-header h1 {
      font-size: 6rem;
    }

    .writing-item {
      padding-top: 4rem;
      margin-top: 4rem;
    }
  }
</style>
